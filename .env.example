# Copy this file to ".env" and fill in your own value.
#
# Base URL of the deployed User API, INCLUDING the /api/user path and with
# NO trailing slash, e.g.
#   NEXT_PUBLIC_API_URL=https://your-user-api.vercel.app/api/user
#
# For local testing against the User API running via `npm start` in ../user-api:
#   NEXT_PUBLIC_API_URL=http://localhost:8080/api/user
NEXT_PUBLIC_API_URL=PASTE_YOUR_USER_API_URL_HERE
